rules_version = '2';

service cloud.firestore {
	match /databases/{database}/documents {
		function signedIn() {
			return request.auth != null;
		}

		function admin() {
			return signedIn()
				&& (request.auth.token.admin == true
					|| request.auth.token.email == 'steveokyere910@gmail.com'
					|| (exists(/databases/$(database)/documents/adminStatus/config)
						&& get(/databases/$(database)/documents/adminStatus/config).data.createdBy == request.auth.uid));
		}

		function validReview(data) {
			return data.keys().hasOnly([
					'productId', 'productName', 'userId', 'userName',
					'rating', 'comment', 'createdAt'
				])
				&& (data.productId is number || (data.productId is string && data.productId.size() > 0 && data.productId.size() <= 120))
				&& data.productName is string
				&& data.productName.size() > 0
				&& data.productName.size() <= 120
				&& data.userId is string
				&& data.userName is string
				&& data.userName.size() > 0
				&& data.userName.size() <= 120
				&& data.rating is number
				&& data.rating >= 1
				&& data.rating <= 5
				&& data.rating % 1 == 0
				&& data.comment is string
				&& data.comment.size() > 0
				&& data.comment.size() <= 500
				&& data.createdAt is timestamp;
		}

		match /products/{productId} {
			allow read: if true;
			allow create, update: if admin()
				&& request.resource.data.keys().hasOnly(['id', 'name', 'category', 'price', 'stock', 'icon', 'tone', 'tag', 'imageUrl', 'updatedAt'])
				&& request.resource.data.id == productId
				&& request.resource.data.name is string
				&& request.resource.data.name.size() > 0
				&& request.resource.data.name.size() <= 120
				&& request.resource.data.category in ['Beauty', 'Accessories', 'Home', 'Lifestyle']
				&& request.resource.data.price is number
				&& request.resource.data.price >= 0
				&& request.resource.data.stock is number
				&& request.resource.data.stock >= 0
				&& request.resource.data.stock % 1 == 0
				&& request.resource.data.icon is string
				&& request.resource.data.tone is string
				&& request.resource.data.tag is string
				&& request.resource.data.imageUrl is string
				&& request.resource.data.imageUrl.size() <= 2000
				&& (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('^https://.*'))
				&& request.resource.data.updatedAt is timestamp;
			allow delete: if admin();
		}

		match /siteContent/{contentId} {
			allow read: if true;
			allow create, update: if admin()
				&& contentId == 'featuredVideo'
				&& request.resource.data.keys().hasOnly(['url', 'title', 'description', 'enabled', 'updatedAt'])
				&& request.resource.data.url is string
				&& request.resource.data.url.matches('^https://.*')
				&& request.resource.data.url.size() <= 2000
				&& request.resource.data.title is string
				&& request.resource.data.title.size() <= 160
				&& request.resource.data.description is string
				&& request.resource.data.description.size() <= 300
				&& request.resource.data.enabled is bool
				&& request.resource.data.updatedAt is timestamp;
			allow delete: if admin() && contentId == 'featuredVideo';
		}

		match /wishlists/{userId} {
			allow read: if signedIn() && userId == request.auth.uid;
			allow create, update: if signedIn()
				&& userId == request.auth.uid
				&& request.resource.data.userId == request.auth.uid
				&& request.resource.data.email == request.auth.token.email
				&& request.resource.data.items is list
				&& request.resource.data.items.size() <= 100
				&& request.resource.data.keys().hasOnly(['userId', 'email', 'items', 'updatedAt'])
				&& request.resource.data.updatedAt is timestamp;
			allow delete: if signedIn() && userId == request.auth.uid;
		}

		match /orders/{orderId} {
			allow create: if false;
			allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
			allow update: if admin()
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt'])
				&& resource.data.status == 'paid'
				&& request.resource.data.status == 'delivered'
				&& request.resource.data.deliveredAt is timestamp;
			allow delete: if false;
		}

		match /reviews/{reviewId} {
			allow read: if true;
			allow create: if signedIn()
				&& validReview(request.resource.data)
				&& request.resource.data.userId == request.auth.uid;
			allow update: if signedIn()
				&& resource.data.userId == request.auth.uid
				&& validReview(request.resource.data)
				&& request.resource.data.userId == resource.data.userId
				&& request.resource.data.productId == resource.data.productId
				&& request.resource.data.productName == resource.data.productName
				&& request.resource.data.createdAt == resource.data.createdAt;
			allow delete: if signedIn() && resource.data.userId == request.auth.uid;
		}

		match /notifications/{notificationId} {
			allow read: if signedIn()
				&& ((resource.data.audience == 'all' && resource.data.recipientId == '')
					|| (resource.data.audience == 'user' && resource.data.recipientId == request.auth.uid));
			allow create: if (
					admin()
					&& request.resource.data.keys().hasOnly(['title', 'message', 'audience', 'recipientId', 'createdAt'])
					&& request.resource.data.title is string
					&& request.resource.data.message is string
					&& request.resource.data.audience in ['all', 'user']
					&& request.resource.data.recipientId is string
					&& ((request.resource.data.audience == 'all' && request.resource.data.recipientId == '')
						|| (request.resource.data.audience == 'user' && request.resource.data.recipientId.size() > 0))
					&& request.resource.data.createdAt is timestamp
				) || (
					signedIn()
					&& request.resource.data.keys().hasOnly(['title', 'message', 'audience', 'recipientId', 'createdAt'])
					&& request.resource.data.title == "Thank you for joining Val's Glam Shop"
					&& request.resource.data.message is string
					&& request.resource.data.audience == 'user'
					&& request.resource.data.recipientId == request.auth.uid
					&& request.resource.data.createdAt is timestamp
				);
			allow update, delete: if admin();
		}

		match /staff/{staffId} {
			allow read, write: if admin();
		}

		match /pushTokens/{tokenId} {
			allow create, update: if signedIn()
				&& request.resource.data.userId == request.auth.uid
				&& request.resource.data.token is string
				&& request.resource.data.token.size() > 0
				&& request.resource.data.token.size() <= 4096
				&& request.resource.data.email is string
				&& request.resource.data.updatedAt is timestamp
				&& request.resource.data.keys().hasOnly(['token', 'userId', 'email', 'updatedAt']);
			allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
		}

		match /subscribers/{subscriberId} {
			allow create, update: if subscriberId == request.resource.data.email
				&& request.resource.data.email is string
				&& request.resource.data.email.size() <= 254
				&& request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
				&& request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source'])
				&& request.resource.data.source == 'website'
				&& request.resource.data.subscribedAt is timestamp;
			allow read, delete: if false;
		}

		match /adminRequests/{requestId} {
			allow create: if signedIn()
				&& request.auth.token.email == 'steveokyere910@gmail.com'
				&& requestId == request.auth.uid
				&& !exists(/databases/$(database)/documents/adminStatus/config)
				&& getAfter(/databases/$(database)/documents/adminStatus/config).data.createdBy == request.auth.uid
				&& request.resource.data.uid == request.auth.uid
				&& request.resource.data.status == 'pending'
				&& request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'status', 'createdAt']);
			allow read, update, delete: if admin();
		}

		match /adminStatus/{statusId} {
			allow read: if true;
			allow create: if signedIn()
				&& statusId == 'config'
				&& request.auth.token.email == 'steveokyere910@gmail.com'
				&& !exists(/databases/$(database)/documents/adminStatus/config)
				&& getAfter(/databases/$(database)/documents/adminRequests/$(request.auth.uid)).data.uid == request.auth.uid
				&& request.resource.data.setupComplete == true
				&& request.resource.data.createdBy == request.auth.uid
				&& request.resource.data.keys().hasOnly(['setupComplete', 'createdBy', 'createdAt']);
			allow update, delete: if false;
		}
	}
}
